# The API base the browser calls.
#
# Leave it unset for local development: the Vite dev server proxies /api to the
# API, and the app then only ever talks to one origin.
#
# A deployment sets it to the API's public origin plus /api/v1, for example
# https://web3-wallet-api.onrender.com/api/v1. This value is compiled into the
# bundle, so it is public by definition: never put a secret here.
# VITE_API_BASE_URL=https://web3-wallet-api.onrender.com/api/v1
