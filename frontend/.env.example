# Target the Vite dev server proxies /api to. Development only.
#
# The browser never sees this value: the application only ever requests the
# relative path /api/v1, and the dev server forwards it. The name has no VITE_
# prefix on purpose, so it can never be inlined into the bundle.
#
# The proxy is required, not a convenience. The API sends no CORS headers, so a
# browser cannot call it cross-origin.
API_PROXY_TARGET=http://localhost:8080
